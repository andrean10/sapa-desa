# URL project Supabase staging atau self-hosted.
NUXT_PUBLIC_SUPABASE_URL=

# Anon key boleh dipakai browser; tetap isi dari konfigurasi project.
NUXT_PUBLIC_SUPABASE_ANON_KEY=

# Rahasia server. Jangan gunakan awalan NUXT_PUBLIC_.
NUXT_SUPABASE_SERVICE_ROLE_KEY=

# Banner mode aplikasi; tidak mengubah hak akses.
NUXT_PUBLIC_APP_MODE=test
